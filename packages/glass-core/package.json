{
  "name": "@lglite/glass-core",
  "version": "0.1.0",
  "description": "The glass engine behind @lglite/react: tokens, provider, Chromium refraction rim lens, accessibility fallbacks.",
  "license": "MIT",
  "author": "Iskandar Roslen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iskz17/lglite.git",
    "directory": "packages/glass-core"
  },
  "homepage": "https://github.com/Iskz17/lglite",
  "bugs": "https://github.com/Iskz17/lglite/issues",
  "keywords": [
    "liquid-glass",
    "glassmorphism",
    "backdrop-filter",
    "design-tokens",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*"
  },
  "files": ["dist", "src/styles"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "@radix-ui/react-slot": "^1.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
